{
    "name": "rekhu/laravel-dev",
    "description": "Rekhu Builder for Laravel: connects a Laravel app to its agent in a Rekhu account. It reads the running app, fixes errors on a git branch with tests, and watches the live site.",
    "keywords": ["laravel", "ai", "agent", "rekhu", "t-builder", "debugging", "monitoring"],
    "homepage": "https://rekhu.com/products",
    "type": "library",
    "license": "proprietary",
    "authors": [{ "name": "Rekhu, a product of Charisma Design", "email": "hello@rekhu.com", "homepage": "https://rekhu.com" }],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/process": "^11.0|^12.0|^13.0",
        "ext-zip": "*"
    },
    "autoload": {
        "psr-4": { "Rekhu\\LaravelDev\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Rekhu\\LaravelDev\\RekhuServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
