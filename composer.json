{
    "name": "rekhu/laravel-dev",
    "description": "Rekhu Builder for Laravel: connects a Laravel app to its agent in a Rekhu account. It reads the running app, fixes errors on a git branch with tests, and watches the live site.",
    "keywords": [
        "laravel",
        "ai",
        "agent",
        "rekhu",
        "builder",
        "debugging",
        "monitoring"
    ],
    "homepage": "https://rekhu.com/products",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Rekhu",
            "email": "hello@rekhu.com",
            "homepage": "https://rekhu.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.48|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.2",
        "ext-zip": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rekhu\\LaravelDev\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rekhu\\LaravelDev\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rekhu\\LaravelDev\\RekhuServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test"
    },
    "config": {
        "sort-packages": true
    }
}
